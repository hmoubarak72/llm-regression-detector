# Copy to .env and fill in. Never commit .env.
OPENAI_API_KEY=
SLACK_WEBHOOK_URL=

# Optional
# LLMREG_PROVIDER=mock            # offline run, no API calls
# LLMREG_MOCK_ERROR_RATE=0.1      # mock only: inject deterministic misclassifications
# LLMREG_OVERALL_CRITICAL=8       # any threshold: LLMREG_<SECTION>_<KEY>
# LLMREG_REPORT_URL=https://...   # where the HTML report is hosted
